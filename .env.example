# Salin ke .env lalu isi. Jangan di-commit.
# Buat secret:  openssl rand -hex 32   (pakai hex agar aman di URL database)

# URL publik yang dibuka pengguna (tanpa slash akhir). Dipakai untuk isi QR, CORS, tautan email.
# NEXT_PUBLIC_APP_URL ikut tertanam saat build: jika diubah, jalankan `docker compose up -d --build web`.
PUBLIC_URL=https://lab.contoh.com
# Alamat yang dilayani Caddy: nama domain (HTTPS otomatis) atau :80 untuk uji tanpa TLS.
SITE_ADDRESS=lab.contoh.com

POSTGRES_PASSWORD=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Secret frontend NextAuth (BEDA dari JWT di atas)
AUTH_SECRET=

# Email pengingat (opsional)
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Lab Equipment <no-reply@contoh.com>"

# SITE_ADDRESS di .env:
#   lab.contoh.com  -> HTTPS otomatis (Let's Encrypt; DNS harus mengarah ke server, port 80/443 terbuka)
#   :80             -> HTTP saja (hanya untuk uji; kamera pemindai QR TIDAK jalan tanpa HTTPS)
{$SITE_ADDRESS} {
	encode zstd gzip

	# Unggahan dokumen/sertifikat sampai ±14 MB (data URL base64 dari file 10 MB).
	request_body {
		max_size 20MB
	}

	# Perangkat IoT (opsional): buka HANYA jalur ini ke backend. Aktifkan dengan menghapus tanda # di 3 baris berikut.
	# handle /api/v1/monitoring/readings* {
	# 	reverse_proxy api:3000
	# }

	# Caddy menimpa X-Forwarded-For/-Proto/-Host dengan nilai yang ia lihat sendiri, jadi klien tidak bisa memalsukan IP.
	# Next.js meneruskan IP itu ke backend (rate limit login dan log aktivitas per pengguna).
	reverse_proxy web:3001
}
